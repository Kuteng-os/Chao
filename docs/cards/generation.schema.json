{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:chao:cards:generation:1.0.0",
  "title": "GenerationResult 1.0.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "ok"
        },
        "card": {
          "$ref": "urn:chao:cards:card:1.0.0"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "minItems": 0,
          "maxItems": 12
        },
        "explanation": {
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        }
      },
      "required": [
        "status",
        "card",
        "assumptions",
        "explanation"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "needs_clarification"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "minItems": 0,
                "maxItems": 4
              }
            },
            "required": [
              "id",
              "question",
              "options"
            ]
          },
          "minItems": 1,
          "maxItems": 3
        }
      },
      "required": [
        "status",
        "questions"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "unsupported"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1,
          "maxItems": 8
        },
        "suggestions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 0,
          "maxItems": 5
        }
      },
      "required": [
        "status",
        "reasons",
        "suggestions"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "needs_keyword_registration"
        },
        "proposals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "requested_behavior": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "name",
              "description",
              "requested_behavior"
            ]
          },
          "minItems": 1,
          "maxItems": 3
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "minItems": 0,
                "maxItems": 4
              }
            },
            "required": [
              "id",
              "question",
              "options"
            ]
          },
          "minItems": 0,
          "maxItems": 3
        }
      },
      "required": [
        "status",
        "proposals",
        "questions"
      ]
    }
  ]
}
