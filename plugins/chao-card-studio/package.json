{
  "name": "dsh-plugin-chao-card-studio",
  "version": "1.2.1",
  "type": "module",
  "description": "《巢战》做卡工坊：在 DSH 里填表生成合法卡牌，一键校验并提交 PR",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "keywords": ["dsh", "deepseek-harness", "plugin", "chao", "card", "做卡"],
  "author": "Kuteng-os",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiangwu738-design/Chao.git",
    "directory": "plugins/chao-card-studio"
  },
  "homepage": "https://github.com/xiangwu738-design/Chao/tree/main/plugins/chao-card-studio",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  }
}
