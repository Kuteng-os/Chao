+void InternalCubismRenderer2D::build_cache(const Csm::CubismModel *model, InternalCubismRendererResource &res)
+{
+    const Csm::csmInt32 count = model->GetDrawableCount();
+    this->_nodes.assign(count, nullptr);
+    this->_orders.assign(count, -1);
+    this->_mask_source.assign(count, false);
+    this->_rect_set.assign(count, false);
+    for (Csm::csmInt32 index = 0; index < count; index++) {
+        CubismIdHandle handle = model->GetDrawableId(index);
+        String node_name(handle->GetString().GetRawString());
+        if (res.dict_mesh.has(node_name)) this->_nodes[index] = Object::cast_to<MeshInstance2D>(res.dict_mesh[node_name]);
+        for (Csm::csmInt32 m = 0; m < model->GetDrawableMaskCounts()[index]; m++) {
+            const Csm::csmInt32 j = model->GetDrawableMasks()[index][m];
+            if (j >= 0 && j < count) this->_mask_source[j] = true;
+        }
+    }
+    this->_cache_ready = true;
+}
